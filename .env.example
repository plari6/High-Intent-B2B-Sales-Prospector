# Gemini (optional but recommended). Free key: https://aistudio.google.com/app/apikey
# Without it the tool runs rule-based only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Used automatically when the main model is overloaded or out of daily quota ("none" disables)
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Free tier allows ~15 requests/min per model. 0 = no limit.
GEMINI_RPM=14
GEMINI_TIMEOUT_MS=60000

# What you sell and who you sell to. Gemini uses these for the 0-10 fit score and the opener.
SENDER_OFFER="AI automation agency: lead gen, CRM and RevOps workflows for startups"
TARGET_ICP="Seed to Series B B2B startups, 5-200 employees"

# Extra keyword phrases to flag, comma separated (also used for --google-news searches)
KEYWORDS=

# Scan settings
LOOKBACK_DAYS=7
MIN_SCORE=40
MAX_AI_LEADS=25
OUTPUT_DIR=output
# FEEDS_FILE=config/feeds.json
# STATE_FILE=data/state.json
FETCH_TIMEOUT_MS=15000

# Optional: post leads to Slack / Discord / Zapier / Make / n8n / any URL
WEBHOOK_URL=
